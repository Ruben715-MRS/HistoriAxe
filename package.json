{
  "name": "historiaxe",
  "version": "1.0.0",
  "description": "HistoriAxe — Le Quiz Chronologique (PWA & iOS Native App)",
  "private": true,
  "scripts": {
    "build:pack": "node scripts/build_pack.js",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.generated.css --minify",
    "build:native": "npm run build:css && node scripts/build.js --native",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:open:ios": "cap open ios",
    "cap:build:ios": "npm run build:native && npx cap sync ios",
    "build": "npm run build:css && node scripts/build.js",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "axe-core": "^4.13.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^3.4.19"
  }
}
