{
  "name": "historiaxe",
  "version": "1.0.0",
  "description": "HistoriAxe — Le Quiz Chronologique (PWA & iOS Native App)",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.generated.css --minify",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "cap open ios",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "build": "npm run build:css && node scripts/build.js",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
